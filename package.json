{
  "name": "panopublish-dm-automation",
  "version": "1.0.0",
  "description": "Production-ready AI Instagram DM Automation System for PanoPublish 360° Virtual Tour SaaS",
  "main": "cli/panopublish-cli.js",
  "bin": {
    "panopublish-dm": "./cli/panopublish-cli.js"
  },
  "scripts": {
    "setup": "node cli/panopublish-cli.js setup",
    "auth": "node cli/panopublish-cli.js auth",
