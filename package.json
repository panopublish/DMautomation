    "scan": "node cli/panopublish-cli.js scan",
    "dms": "node cli/panopublish-cli.js dms",
    "analyze": "node cli/panopublish-cli.js analyze",
    "approve": "node cli/panopublish-cli.js approve",
    "reject": "node cli/panopublish-cli.js reject",
