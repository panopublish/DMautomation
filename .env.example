# ================================================================
# PanoPublish Instagram DM Automation Configuration
# ================================================================

# ----------------------------------------------------------------
# 1. BRAVE BROWSER & CDP CONNECTION
# ----------------------------------------------------------------
# The automation attaches to your existing running Brave browser session.
# Launch Brave with: brave.exe --remote-debugging-port=9222
BRAVE_CDP_URL=http://127.0.0.1:9222
INSTAGRAM_HOME_URL=https://www.instagram.com/
INSTAGRAM_MESSAGES_URL=https://www.instagram.com/direct/inbox/

# Target Instagram account ID/folder name (for multi-account awareness)
DEFAULT_ACCOUNT_ID=instagram-account-1

# ----------------------------------------------------------------
# 2. AI PROVIDER (OpenAI-compatible)
# ----------------------------------------------------------------
# Supports any OpenAI-compatible endpoint (OpenAI, DeepSeek, Groq, Ollama, etc.)
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_compatible_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=60000

# ----------------------------------------------------------------
# 3. SAFETY, APPROVAL & EXECUTION MODES
# ----------------------------------------------------------------
# DRY_RUN: When true, never sends any messages in the browser
DRY_RUN=true

# APPROVAL_MODE: When true, AI responses require manual CLI approval before sending
APPROVAL_MODE=true

# POSTING_ENABLED: Must be explicitly true to allow live browser dispatch
POSTING_ENABLED=false

# ----------------------------------------------------------------
# 4. CONSERVATIVE RATE LIMITING
# ----------------------------------------------------------------
# Maximum DM replies allowed per hour
MAX_DM_REPLIES_PER_HOUR=10

# Maximum DM replies allowed per day
MAX_DM_REPLIES_PER_DAY=30

# Delays between actions (milliseconds) for human-like pacing
MIN_ACTION_DELAY_MS=15000
MAX_ACTION_DELAY_MS=45000

# ----------------------------------------------------------------
# 5. PANOPUBLISH PRODUCT LINKS
# ----------------------------------------------------------------
# When relevant, AI may suggest ONE helpful link based on user intent.
PANO_PUBLISH_WEBSITE=https://panopublish.com
PANO_PUBLISH_SIGNUP=https://panopublish.com/signup
PANO_PUBLISH_TUTORIAL=https://panopublish.com/tutorials

# ----------------------------------------------------------------
# 6. LOGGING & DATA DIRECTORIES
# ----------------------------------------------------------------
LOGS_DIR=./logs
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
